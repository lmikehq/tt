{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "typeRoots": ["types"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@atom/*": ["src/components/atoms/*"],
      "@organism/*": ["src/components/organisms/*"],
      "@molecule/*": ["src/components/molecules/*"],
      "@components/*": ["src/components/*"],
      "@layout/*": ["src/components/layouts/*"],
      "@template/*": ["src/components/templates/*"],
      "@style/*": ["src/styles/*"],
      "@image/*": ["/assets/images/*"],
      "@lottie/*": ["/assets/lotties/*"],
      "@font/*": ["assets/fonts/*"],
      "@icon/*": ["src/components/molecules/icons/*"],
      "/assets/flags/*": ["/assets/flags/*"],
      "@lib/*": ["src/lib/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/components/organisms/form/components/previewSteps"],
  "exclude": ["node_modules"]
}
